{
  "name": "midnight-table",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "vitest run",
    "sim": "tsx packages/sim/src/cli.ts",
    "screens": "tsx apps/web/e2e/screens.ts",
    "reconnect": "tsx apps/web/e2e/reconnect.ts",
    "rehearsal": "tsx apps/web/e2e/rehearsal.ts && pnpm reconnect && pnpm screens --out data/rehearsal-screens",
    "build": "pnpm --filter @midnight/web build",
    "start": "pnpm build && tsx scripts/start.ts",
    "start:local": "pnpm build && TUNNEL=none tsx scripts/start.ts",
    "start:server": "pnpm --filter @midnight/server start",
    "dev:server": "pnpm --filter @midnight/server dev",
    "dev:web": "pnpm --filter @midnight/web dev"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.6",
    "eslint": "^10.14.0",
    "fast-check": "^4.10.2",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.0.5"
  }
}
